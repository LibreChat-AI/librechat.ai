# Docs feedback (GitHub Discussions + Discord)
# GitHub personal access token with discussions:write scope (optional)
GITHUB_FEEDBACK_TOKEN=
# GitHub repository node ID — run: gh api graphql -f query='{repository(owner:"LibreChat-AI",name:"librechat.ai"){id}}'
GITHUB_DISCUSSION_REPO_ID=
# GitHub discussion category node ID — run: gh api graphql -f query='{repository(owner:"LibreChat-AI",name:"librechat.ai"){discussionCategory(slug:"feedback"){id}}}'
GITHUB_DISCUSSION_CATEGORY_ID=
# Discord webhook URL for real-time feedback notifications (optional)
DISCORD_FEEDBACK_WEBHOOK=

# Analytics and feedback
# Slack webhook URL for notifications (optional)
SLACK_WEBHOOK_URL=
# Loops API key for email automation (required for newsletter subscriptions)
LOOPS_API_KEY=
# Core Web Vitals ingestion config (optional, public)
NEXT_PUBLIC_CWV_PROJECT_ID=64ddab45-756f-474b-a8c9-266d264c93d8
NEXT_PUBLIC_CWV_ENDPOINT=
NEXT_PUBLIC_CWV_SAMPLE_RATE=0.5

# Crisp live chat widget ID (optional, public)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# QA chatbot powered by OpenAI + Supabase
# OpenAI API key for the QA chatbot (optional)
OPENAI_API_KEY=
# Supabase project URL (optional)
SUPABASE_URL=
# Supabase service role key for server-side access (optional, secret)
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for signed newsletter unsubscribe links (required for /api/unsubscribe)
UNSUBSCRIBE_SECRET=
# Public origin used in signed links for this deployment (for example,
# https://www.librechat.ai).
NEWSLETTER_PUBLIC_URL=
# Loops transactional email ID for the subscription email. Its template must
# render the `unsubscribeUrl` data variable.
LOOPS_UNSUBSCRIBE_TRANSACTIONAL_ID=

# Docs AI chat (OpenRouter)
# OpenRouter API key — get one at https://openrouter.ai/keys (optional)
OPENROUTER_API_KEY=
# OpenRouter model ID (default: openai/gpt-5.4-nano)
OPENROUTER_MODEL=
# Model used for automatic docs translation (default: openai/gpt-5.4-nano)
OPENROUTER_TRANSLATE_MODEL=

# Upstash Redis — rate limiting for AI chat and newsletter email delivery
# (required for newsletter subscriptions)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" only when every request is guaranteed to reach the app through
# Cloudflare, so rate limiters (chat, subscribe, unsubscribe) can trust
# cf-connecting-ip as the client IP. Leave unset on preview/platform
# hostnames or non-proxied origins. Per-client limiting is skipped there because
# all client-IP headers can be forged by a direct requester. Vercel deployments
# automatically use Vercel's authenticated x-vercel-forwarded-for header.
TRUST_CF_CONNECTING_IP=

# Langfuse observability keys (optional)
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Newsletter subscribers database
# MongoDB connection string for storing subscriber data (required for /api/subscribe and /api/unsubscribe)
MONGODB_URI=
